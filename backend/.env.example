# Satori Backend Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=Satori Backend
APP_VERSION=0.1.0
DEBUG=false

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# KataGo Configuration
# Set to true to enable KataGo analysis
KATAGO_ENABLED=false

# Path to KataGo executable
# Example: /usr/local/bin/katago or C:\katago\katago.exe
KATAGO_BINARY_PATH=

# Path to KataGo model file (.bin.gz)
# Download from: https://github.com/lightvector/KataGo/releases
# Recommended: b18c384nbt-s1184076672-d1665968314.bin.gz
KATAGO_MODEL_PATH=

# Path to KataGo config file (optional)
# If not provided, KataGo will use default settings
KATAGO_CONFIG_PATH=

# Gemini Configuration (Future)
GEMINI_ENABLED=false
GEMINI_API_KEY=
